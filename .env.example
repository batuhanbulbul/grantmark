# Grantmark environment template.
# Copy to .env and fill in local values. Never commit .env.
# Devnet / test-mode values only. Mainnet keys and live Stripe keys are not allowed.

# HTTP port and SQLite file (relative paths are relative to the working directory).
PORT=8787
DATABASE_PATH=data/grantmark.db

# Where this server is reachable (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8787

# Identifiers written into the seeded HCS declarations. HCS requires absolute HTTPS URLs.
# For a deployment, set LICENSE_SERVER_URL to <PUBLIC_BASE_URL>/olp.
REGISTRY_ID=https://registry.grantmark.example
LICENSE_SERVER_URL=https://license.grantmark.example/olp

# Enables the demo admin endpoints when set (at least 16 characters). Leave empty to disable.
ADMIN_TOKEN=

# Payments: Solana devnet only (the server refuses any other cluster). Public keys only;
# the server never holds a Solana private key.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional fee for whoever operates this server: wallet and basis points (default 1000 = 10%).
# The rights holder receives the rest.
OPERATOR_WALLET=
OPERATOR_FEE_BPS=
# Seeding: payout wallet for the fictional rights holders, and the demo OLP client.
DEMO_RIGHTS_HOLDER_WALLET=
DEMO_CLIENT_ID=demo-studio
DEMO_CLIENT_SECRET=

# Abuse protection: requests per minute and address on the public /v1 endpoints (OLP and
# payment clients get five times as many). Set TRUST_PROXY=1 only behind exactly one reverse
# proxy that appends the client address to X-Forwarded-For (e.g. Fly.io, Railway).
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=
