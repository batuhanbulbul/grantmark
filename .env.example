# Grantmark environment template.
# Copy to .env and fill in local values. Never commit .env.
# Devnet / test-mode values only. Mainnet keys and live Stripe keys are not allowed.

# HTTP port and SQLite file (relative paths are relative to the working directory).
PORT=8787
DATABASE_PATH=data/grantmark.db

# Where this server is reachable (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8787

# Identifiers written into the seeded HCS declarations. HCS requires absolute HTTPS URLs.
# For a deployment, set LICENSE_SERVER_URL to <PUBLIC_BASE_URL>/olp.
REGISTRY_ID=https://registry.grantmark.example
LICENSE_SERVER_URL=https://license.grantmark.example/olp

# Enables the demo admin endpoints when set (at least 16 characters). Leave empty to disable.
ADMIN_TOKEN=
