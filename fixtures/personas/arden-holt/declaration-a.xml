<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fictional test data for Grantmark. Arden Holt is not a real person.
  Persona: a subject with two conflicting declarations. This one permits hcs:ai-generate for
  payment on "image likeness"; declaration-b.xml, from another registry, prohibits it on
  "likeness voice". They overlap on "likeness" (HCS 1.0 Draft, section 3.1.9).
  HCRN and HCSI values come from the HCS reserved test range (HCS 1.0 Draft, section 4.6).
-->
<rsl xmlns="https://rslstandard.org/rsl"
     xmlns:hcs="https://humanconsent.org/hcs">

  <hcs:right
    registry="https://registry.grantmark.example"
    registration-id="HCRN-0000-006B-J"
    issued="2026-09-05T12:00:00Z"
    subject="identity"
    subject-scope="image likeness"
    subject-id="HCSI-0000-0037-X"
    server="https://license.grantmark.example/olp">

    <schema type="application/ld+json"><![CDATA[
      {
        "@context": "https://schema.org",
        "@id": "https://id.humanconsent.org/HCSI-0000-0037-X",
        "@type": "Person",
        "additionalType": "https://humanconsent.org/schemas/identity",
        "name": "Arden Holt",
        "description": "Fictional person created for Grantmark tests.",
        "identifier": [
          {
            "@type": "PropertyValue",
            "propertyID": "OfficialPage",
            "url": "https://personas.grantmark.example/arden-holt"
          }
        ]
      }
    ]]></schema>

    <license>
      <permits type="usage">hcs:ai-generate</permits>
      <payment type="purchase">
        <amount currency="USD">4.00</amount>
      </payment>
      <legal type="attestation">true</legal>
      <legal type="contact">https://registry.grantmark.example/contact/arden-holt</legal>
    </license>

  </hcs:right>
</rsl>
